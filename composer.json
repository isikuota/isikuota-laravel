{
    "name": "isikuota/laravel",
    "description": "Integrasi Laravel untuk IsiKuota API: facade, config, route webhook, dan event.",
    "type": "library",
    "keywords": ["isikuota", "ppob", "pulsa", "laravel", "webhook"],
    "homepage": "https://isikuota.com/docs",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "isikuota/isikuota-php": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../isikuota-php"
        }
    ],
    "autoload": {
        "psr-4": {
            "IsiKuota\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IsiKuota\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IsiKuota\\Laravel\\IsiKuotaServiceProvider"
            ],
            "aliases": {
                "IsiKuota": "IsiKuota\\Laravel\\Facades\\IsiKuota"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
